{
  "name": "hanzi-home-mobile",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Bloomko as an offline Android app",
  "scripts": {
    "build": "node scripts/build-web.mjs",
    "sync": "npm run build && npx cap sync android",
    "apk": "npm run sync && cd android && ./gradlew assembleDebug",
    "build:server": "node scripts/build-server.mjs",
    "typecheck": "tsc -p .",
    "test": "tsx --test tests/*.test.ts",
    "test:e2e": "tsx --test --test-concurrency=1 tests/e2e/*.e2e.ts"
  },
  "dependencies": {
    "@capacitor-community/speech-recognition": "7.0.1",
    "@capacitor-community/text-to-speech": "8.0.2",
    "@capacitor/android": "8.5.3",
    "@capacitor/core": "8.5.3",
    "@capacitor/filesystem": "8.1.4",
    "@capacitor/local-notifications": "8.3.1",
    "@capacitor/preferences": "8.0.1",
    "@capacitor/share": "8.0.3",
    "@k1low/hanzi-writer-data-jp": "0.8.0",
    "fflate": "^0.8.2",
    "fzstd": "^0.1.1",
    "pinyin-pro": "3.29.5",
    "sql.js": "^1.12.0",
    "wanakana": "5.3.1"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.3",
    "@fontsource/lora": "5.3.0",
    "@fontsource/nunito": "^5.2.7",
    "@fontsource/shippori-mincho": "5.3.0",
    "@types/sql.js": "^1.4.9",
    "esbuild": "0.28.2",
    "hanzi-writer-data": "2.0.1",
    "playwright": "^1.63.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  }
}
